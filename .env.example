# ---------------------------------------------------------------------------
# CockroachDB
# ---------------------------------------------------------------------------
# Local 9-node cluster from docker-compose. psycopg accepts several hosts and
# fails over between them, so the app keeps running when a region goes away
# without any load balancer in front.
UNSAY_DSN=postgresql://root@localhost:26257,localhost:26258,localhost:26259/unsay?sslmode=disable

# CockroachDB Cloud cluster (used for the Managed MCP Server + ccloud demos).
# Copy from the Cloud console: Connect > General connection string.
UNSAY_CLOUD_DSN=

# ---------------------------------------------------------------------------
# CockroachDB Cloud Managed MCP Server
# ---------------------------------------------------------------------------
# Service-account API key with the mcp:read scope. The agent uses this to
# introspect live schema before writing SQL, rather than guessing at it.
CRDB_MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
CRDB_MCP_API_KEY=
CRDB_CLUSTER_ID=

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# Reasoning model on Amazon Bedrock.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Embedding model on Amazon Bedrock. Titan Text Embeddings V2 emits 1024
# dimensions, matching VECTOR(1024) in sql/002_schema.sql. Changing this model
# means changing that column width too.
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024

# S3 bucket holding raw openFDA snapshots and signed audit exports.
UNSAY_S3_BUCKET=

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# openFDA works without a key at 240 requests/min. A free key raises that to
# 240/min per key and 120k/day: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
